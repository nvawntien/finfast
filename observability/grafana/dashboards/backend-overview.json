{
  "uid": "finfast-backend-overview",
  "title": "FinFast — Backend Overview",
  "description": "Framework HTTP/JVM/Hikari metrics only. Scrape UP and pool occupancy do not prove database availability. Missing series remain No data; rates need two samples. Logs and traces remain in Explore.",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "tags": [
    "finfast",
    "backend"
  ],
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "finfast-prometheus"
        },
        "query": "label_values(process_uptime_seconds{job=\"finfast-backend\"}, environment)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Service health",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "title": "Backend scrape availability (not database health)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "finfast-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"finfast-backend\"}",
          "legendFormat": "{{environment}} / {{instance}}",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "Application uptime",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "finfast-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_uptime_seconds{job=\"finfast-backend\",environment=~\"$environment\"}",
          "legendFormat": "{{environment}} / {{instance}}",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
