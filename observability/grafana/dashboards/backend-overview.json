    {
      "id": 7,
      "title": "HTTP responses by status class",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "finfast-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status_class) (label_replace(rate(http_server_requests_seconds_count{job=\"finfast-backend\",environment=~\"$environment\",uri!~\"/actuator.*\"}[5m]), \"status_class\", \"${1}xx\", \"status\", \"([1-5])[0-9][0-9]\"))",
          "legendFormat": "{{status_class}}",
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
