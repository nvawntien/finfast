# Local only. Choose credentials; do not reuse public-deployment credentials.
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
# Host 3000 is reserved for the frontend; Grafana always listens on 3000 internally.
GRAFANA_PORT=3300
FINFAST_APP_PROJECT=finfast
FINFAST_OBSERVABILITY_NETWORK=finfast_observability
# Rootless Docker may need /run/user/<uid>/docker.sock instead.
DOCKER_SOCKET_PATH=/var/run/docker.sock
